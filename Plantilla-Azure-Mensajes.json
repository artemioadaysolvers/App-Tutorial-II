{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "2998626772464882476"
    }
  },
  "parameters": {
    "prefix": {
      "type": "string",
      "minLength": 3,
      "maxLength": 16,
      "metadata": {
        "description": "Prefijo de 3 a 16 caracteres: letras minúsculas y números. Usar un grupo de recursos nuevo."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "googleWebClientId": {
      "type": "string"
    },
    "jwtSecret": {
      "type": "securestring",
      "minLength": 32
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id)]",
    "webName": "[format('{0}-api-{1}', parameters('prefix'), variables('suffix'))]",
    "registryName": "[format('{0}{1}', parameters('prefix'), variables('suffix'))]",
    "cosmosName": "[format('{0}-json-{1}', parameters('prefix'), variables('suffix'))]",
    "acrPullRole": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]"
  },
  "resources": [
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[variables('registryName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts",
      "apiVersion": "2024-05-15",
      "name": "[variables('cosmosName')]",
      "location": "[parameters('location')]",
      "kind": "GlobalDocumentDB",
      "properties": {
        "databaseAccountOfferType": "Standard",
        "capabilities": [
          {
            "name": "EnableServerless"
          }
        ],
        "consistencyPolicy": {
          "defaultConsistencyLevel": "Session"
        },
        "locations": [
          {
            "locationName": "[parameters('location')]",
            "failoverPriority": 0,
            "isZoneRedundant": false
          }
        ],
        "minimalTlsVersion": "Tls12",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases",
      "apiVersion": "2024-05-15",
      "name": "[format('{0}/{1}', variables('cosmosName'), 'MensajesDB')]",
      "properties": {
        "resource": {
          "id": "MensajesDB"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', variables('cosmosName'))]"
      ]
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
      "apiVersion": "2024-05-15",
      "name": "[format('{0}/{1}/{2}', variables('cosmosName'), 'MensajesDB', 'mensajes')]",
      "properties": {
        "resource": {
          "id": "mensajes",
          "partitionKey": {
            "paths": [
              "/userId"
            ],
            "kind": "Hash",
            "version": 2
          },
          "indexingPolicy": {
            "indexingMode": "consistent",
            "automatic": true
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', variables('cosmosName'), 'MensajesDB')]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[format('{0}-plan', parameters('prefix'))]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "B1",
        "tier": "Basic"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[variables('webName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux,container",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('prefix')))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "siteConfig": {
          "linuxFxVersion": "DOCKER|mcr.microsoft.com/azuredocs/aci-helloworld:latest",
          "acrUseManagedIdentityCreds": true,
          "alwaysOn": true,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "healthCheckPath": "/ready",
          "appSettings": [
            {
              "name": "WEBSITES_PORT",
              "value": "8080"
            },
            {
              "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE",
              "value": "false"
            },
            {
              "name": "GOOGLE_WEB_CLIENT_ID",
              "value": "[parameters('googleWebClientId')]"
            },
            {
              "name": "JWT_SECRET",
              "value": "[parameters('jwtSecret')]"
            },
            {
              "name": "COSMOS_ENDPOINT",
              "value": "[reference(resourceId('Microsoft.DocumentDB/databaseAccounts', variables('cosmosName')), '2024-05-15').documentEndpoint]"
            },
            {
              "name": "COSMOS_KEY",
              "value": "[listKeys(resourceId('Microsoft.DocumentDB/databaseAccounts', variables('cosmosName')), '2024-05-15').primaryMasterKey]"
            },
            {
              "name": "COSMOS_DATABASE",
              "value": "MensajesDB"
            },
            {
              "name": "COSMOS_CONTAINER",
              "value": "mensajes"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers', variables('cosmosName'), 'MensajesDB', 'mensajes')]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', variables('cosmosName'))]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', variables('cosmosName'), 'MensajesDB')]",
        "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), resourceId('Microsoft.Web/sites', variables('webName')), variables('acrPullRole'))]",
      "properties": {
        "roleDefinitionId": "[variables('acrPullRole')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('webName')), '2024-04-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]",
        "[resourceId('Microsoft.Web/sites', variables('webName'))]"
      ]
    }
  ],
  "outputs": {
    "webAppName": {
      "type": "string",
      "value": "[variables('webName')]"
    },
    "acrName": {
      "type": "string",
      "value": "[variables('registryName')]"
    },
    "cosmosAccount": {
      "type": "string",
      "value": "[variables('cosmosName')]"
    },
    "apiUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('webName')), '2024-04-01').defaultHostName)]"
    },
    "resourceGroup": {
      "type": "string",
      "value": "[resourceGroup().name]"
    }
  }
}