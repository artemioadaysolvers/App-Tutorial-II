{
  "name": "mensajes-app",
  "description": "App Android con Google y formulario de tres mensajes.",
  "private": true,
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-google-signin/google-signin": "16.1.5",
    "expo": "~58.0.11",
    "expo-crypto": "~58.0.6",
    "expo-system-ui": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/validation.test.ts",
    "prebuild:android": "expo prebuild --platform android",
    "check:bundle": "expo export --platform android --output-dir dist-check"
